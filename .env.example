# ---- how the pipeline talks to a model -------------------------------------
# mock   : scripted, offline, free                     (default; no key needed)
# replay : play back responses recorded earlier        (free, deterministic)
# live   : real API calls                              (needs a key)
FF_LLM_MODE=mock

# which vendor "live" uses: groq | openai | openrouter
FF_LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Override the default model. Run scripts/check_provider.py to see what your
# provider currently serves -- model IDs get deprecated regularly.
# FF_MODEL=qwen/qwen3.8-27b

# ---- cassettes (replay mode) ------------------------------------------------
FF_CASSETTE_DIR=cassettes
# Set to 1 with FF_LLM_MODE=replay to call the live API on a cache miss and
# save the response for future runs.
FF_LLM_RECORD=0

# ---- test fixtures ----------------------------------------------------------
# Comma-separated failure injections for the mock, used to test the Phase 3
# detectors: hallucinate,misclassify,drop_context,bad_json
FF_MOCK_CHAOS=
